{
  "manifestVersion": 2,
  "id": "git-identity",
  "name": "Git Identity",
  "version": "0.1.0",
  "description": "Repository Git identity editing, gh account discovery and GitHub push-account binding.",
  "engines": { "orca": ">=1.4.248" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [{ "id": "identity", "title": "Git Identity", "icon": "branch", "entry": "src/panel.tsx", "ui": "components" }],
    "commands": [{ "id": "identity.open", "title": "Git Identity: Edit repository author", "when": "workspace" }],
    "events": [{ "on": "workspace.changed" }]
  },
  "capabilities": [{ "kind": "workspace:read" }]
}
